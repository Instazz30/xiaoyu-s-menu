<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaxiaoyu.xingbangmenu.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.xiaxiaoyu.xingbangmenu.entity.SysUser">
        <id column="id" property="id"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <insert id="insert" parameterType="com.xiaxiaoyu.xingbangmenu.entity.SysUser"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (openid, nickname, avatar_url)
        VALUES (#{openid}, #{nickname}, #{avatarUrl})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_user WHERE id = #{id} AND is_deleted = 0
    </select>

    <select id="selectByOpenid" resultMap="BaseResultMap">
        SELECT * FROM sys_user WHERE openid = #{openid} AND is_deleted = 0
    </select>

    <update id="update" parameterType="com.xiaxiaoyu.xingbangmenu.entity.SysUser">
        UPDATE sys_user SET updated_at = NOW()
        <if test="nickname != null">, nickname = #{nickname}</if>
        <if test="avatarUrl != null">, avatar_url = #{avatarUrl}</if>
        WHERE id = #{id}
    </update>
</mapper>
